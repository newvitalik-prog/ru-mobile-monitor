generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("viewer")
  createdAt DateTime @default(now())
}

model Operator {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  website     String?
  active      Boolean  @default(true)
  notes       String?
  sources     Source[]
  runItems    CollectionRunItem[]
  tariffs     TariffSnapshot[]
  promotions  PromotionSnapshot[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Source {
  id             String    @id @default(cuid())
  operatorId     String
  operator       Operator  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  sourceType     String    @default("b2c_tariffs")
  url            String
  renderer       String    @default("ai")
  trustLevel     String    @default("official_confirmed")
  isActive       Boolean   @default(true)
  notes          String?
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CollectionRun {
  id             String              @id @default(cuid())
  startedAt      DateTime            @default(now())
  finishedAt     DateTime?
  status         String              @default("pending")
  triggerType    String              @default("manual")
  totalOperators Int                 @default(0)
  successCount   Int                 @default(0)
  partialCount   Int                 @default(0)
  failedCount    Int                 @default(0)
  items          CollectionRunItem[]
  tariffs        TariffSnapshot[]
  promotions     PromotionSnapshot[]
  createdAt      DateTime            @default(now())
}

model CollectionRunItem {
  id           String        @id @default(cuid())
  runId        String
  run          CollectionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  operatorId   String
  operator     Operator      @relation(fields: [operatorId], references: [id])
  status       String
  method       String        @default("ai")
  errorMsg     String?
  tariffsFound Int           @default(0)
  promoFound   Int           @default(0)
  durationMs   Int?
  createdAt    DateTime      @default(now())
}

model TariffSnapshot {
  id               String        @id @default(cuid())
  runId            String
  run              CollectionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  operatorId       String
  operator         Operator      @relation(fields: [operatorId], references: [id])
  tariffName       String
  segment          String?
  region           String        @default("Россия")
  monthlyFeeRub    Float?
  activationFeeRub Float?
  dataGb           Float?
  dataUnlimited    Boolean       @default(false)
  voiceMinutes     Int?
  voiceUnlimited   Boolean       @default(false)
  smsCount         Int?
  includedServices String?
  esimAvailable    Boolean?
  roamingNotes     String?
  remarks          String?
  sourceUrl        String?
  collectedAt      DateTime      @default(now())
  parserConfidence Float?
  collectionMethod String?
  rawPayload       String?
}

model PromotionSnapshot {
  id               String        @id @default(cuid())
  runId            String
  run              CollectionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  operatorId       String
  operator         Operator      @relation(fields: [operatorId], references: [id])
  promotionName    String
  promotionType    String?
  mechanismSummary String?
  benefitValue     String?
  startDate        DateTime?
  endDate          DateTime?
  restrictions     String?
  sourceUrl        String?
  ambiguityFlag    Boolean       @default(false)
  collectedAt      DateTime      @default(now())
  parserConfidence Float?
  collectionMethod String?
}

model AppSettings {
  id              String    @id @default(cuid())
  scheduleEnabled Boolean   @default(false)
  schedulePeriod  String    @default("weekly")
  scheduleDay     String    @default("monday")
  scheduleHour    Int       @default(9)
  openrouterModel String    @default("google/gemini-flash-1.5-8b")
  lastRunAt       DateTime?
  updatedAt       DateTime  @updatedAt
}
